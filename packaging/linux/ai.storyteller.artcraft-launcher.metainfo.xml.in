<?xml version="1.0" encoding="UTF-8"?>
<!-- Translated strings in this file may be used under its CC0-1.0 metadata license. -->
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.artcraft-launcher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>ArtCraft Launcher</name>
  <summary>Install, update and launch the Craft App Suite</summary>
  <summary xml:lang="ru">Установка, обновление и запуск приложений Craft App Suite</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      ArtCraft Launcher lists every app in the Craft App Suite (PhotoCraft, LightCraft, FilmCraft,
      DesignCraft, VectorCraft, PdfCraft, EffectCraft, WordCraft, DeckCraft, GridCraft, CADCraft,
      SoundCraft and FigCraft), installs the right build for your computer, and keeps them up to date.
    </p>
    <p xml:lang="ru">
      ArtCraft Launcher показывает все приложения Craft App Suite (PhotoCraft, LightCraft,
      FilmCraft, DesignCraft, VectorCraft, PdfCraft, EffectCraft, WordCraft, DeckCraft,
      GridCraft, CADCraft, SoundCraft и FigCraft), устанавливает подходящую для вашего
      компьютера сборку и поддерживает их в актуальном состоянии.
    </p>
    <ul>
      <li>One place to find, install and open every Craft app</li>
      <li xml:lang="ru">Одно место, чтобы найти, установить и открыть любое приложение Craft</li>
      <li>Checks GitHub releases for updates and installs them for you</li>
      <li xml:lang="ru">Проверяет выпуски на GitHub и сам устанавливает обновления</li>
      <li>Lives in the system tray and tells you when updates are ready</li>
      <li xml:lang="ru">Работает в области уведомлений и сообщает, когда обновления готовы</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.storyteller.artcraft-launcher.desktop</launchable>
  <icon type="stock">ai.storyteller.artcraft-launcher</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps</url>
  <url type="bugtracker">https://github.com/storytold/craft-launcher/issues</url>
  <url type="help">https://github.com/storytold/craft-launcher</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Utility</category>
    <category>PackageManager</category>
  </categories>
  <keywords>
    <keyword>launcher</keyword>
    <keyword xml:lang="ru">лаунчер</keyword>
    <keyword>installer</keyword>
    <keyword xml:lang="ru">установщик</keyword>
    <keyword>updater</keyword>
    <keyword xml:lang="ru">обновление</keyword>
    <keyword>artcraft</keyword>
    <keyword xml:lang="ru">artcraft</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#d9dce3</color>
    <color type="primary" scheme_preference="dark">#26282e</color>
  </branding>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>artcraft-launcher</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
