<?xml version="1.0" encoding="utf-8"?>
<!--
  ArtCraft Launcher MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util
  extensions: `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`).
  Built by package.ps1:

    wix build artcraft-launcher.wxs installer-ui.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc artcraft-launcher.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -o out.msi

  Per-user install (no UAC prompt), by default into %LOCALAPPDATA%\Programs\ArtCraft Launcher, so
  the launcher can update itself without elevation, plus a Start Menu shortcut. The shortcut
  carries the AppUserModelID ai.storyteller.artcraft-launcher, which Windows needs to show toast
  notifications from an unpackaged app and to group the taskbar button. No file associations.

  Double-clicked, it opens the suite's shared setup wizard: Welcome, with a "Create a desktop
  shortcut" box; a folder page to pick where it goes; a progress page; and a Finish page
  with a ticked "Launch ArtCraft Launcher" box. There is no licence page (the code is MIT OR
  Apache-2.0; nothing to accept). The install folder and the desktop-shortcut choice are recorded
  under HKCU and reused by later versions, so an update (the launcher's own self-update runs this
  with /passive, which skips the wizard) lands in the same folder and keeps the user's choice; the
  launcher reads the recorded folder to know it was installed by this MSI.

  Per-user packages can't use a file as a component's KeyPath (ICE38), so each component is
  keyed on an HKCU value, and the folders we create are removed on uninstall (ICE64).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="ArtCraft Launcher"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="1AC08DBF-D4CF-4BA4-A81E-CAA5C1004974"
      Scope="perUser"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="ArtCraft Launcher: install and update the Craft App Suite" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of ArtCraft Launcher is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename; keep the .exe extension (ICE50). -->
    <Icon Id="ArtCraftLauncherIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ArtCraftLauncherIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/storytold/craft-launcher/releases" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ArtCraft Launcher" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- An update installs where the user put the previous version (recorded by
         ArtCraftLauncherApp below; every version since 0.1.0 records it). -->
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\Learning Machines LLC\ArtCraft Launcher" Name="InstallDir" Type="raw" />
    </Property>

    <!-- The desktop shortcut: the folder page's box sets INSTALLDESKTOPSHORTCUT to 1. It starts
         ticked on a first install; an update keeps what the user chose last time, and an update
         from a version that never asked (0.1.0, 0.1.1) adds none. A value given on the command
         line (msiexec ... INSTALLDESKTOPSHORTCUT=0 or 1) wins. -->
    <Property Id="PREVIOUSDESKTOPSHORTCUT">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="HKCU" Key="Software\Learning Machines LLC\ArtCraft Launcher" Name="DesktopShortcutChoice" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLDESKTOPSHORTCUT AND ((NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT PREVIOUSDESKTOPSHORTCUT) OR PREVIOUSDESKTOPSHORTCUT = &quot;1&quot;)" />
    <!-- Recorded as 1 or 0 (an unticked box leaves the property empty), for the next update. -->
    <SetProperty Id="DESKTOPSHORTCUTCHOICE" Action="RememberNoDesktopShortcut" Value="0" Before="InstallInitialize" Sequence="execute"
        Condition="NOT (INSTALLDESKTOPSHORTCUT = &quot;1&quot;)" />
    <SetProperty Id="DESKTOPSHORTCUTCHOICE" Action="RememberDesktopShortcut" Value="1" Before="InstallInitialize" Sequence="execute"
        Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;" />

    <Feature Id="Main" Title="ArtCraft Launcher" Level="1">
      <ComponentGroupRef Id="ArtCraftLauncherFiles" />
      <ComponentGroupRef Id="CraftInstallerSettings" />
    </Feature>





    <Property Id="ArtCraftLauncherVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the launcher, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ArtCraft Launcher" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#ArtCraftLauncherExe]" />
    <!-- Runs in the wizard's own process, so the launcher starts as the user. -->
    <CustomAction Id="LaunchArtCraftLauncher" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <!-- Shared full UI; app installation policy remains below. -->
    <!-- Preserve the previous stock WiX wizard's ARP Modify policy. -->
    <Property Id="ARPNOMODIFY" Value="1" />
    <UIRef Id="CraftInstallerUI" />
  </Package>

  <Fragment>
    <ComponentGroup Id="ArtCraftLauncherFiles">
      <Component Id="ArtCraftLauncherApp" Directory="INSTALLFOLDER" Guid="55DCC431-EBEF-4C11-BABB-6D78CE0ECF4E">
        <File Id="ArtCraftLauncherExe" Source="$(var.BinDir)\artcraft-launcher.exe" KeyPath="no" />
        <!-- Read back by the next version's installer and by the launcher (self_update.rs). -->
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\ArtCraft Launcher" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\ArtCraft Launcher" Name="DesktopShortcutChoice" Value="[DESKTOPSHORTCUTCHOICE]" Type="string" />
        <!-- Win+R "artcraft-launcher". -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\artcraft-launcher.exe" Value="[#ArtCraftLauncherExe]" Type="string" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
      </Component>

      <Component Id="ArtCraftLauncherShortcut" Directory="ProgramMenuFolder" Guid="870F3DFA-BC0F-497F-85D5-A361B04826AF">
        <Shortcut Id="StartMenuShortcut" Name="ArtCraft Launcher"
            Description="Install and update the Craft App Suite"
            Target="[#ArtCraftLauncherExe]" WorkingDirectory="INSTALLFOLDER"
            Icon="ArtCraftLauncherIcon.exe" IconIndex="0">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="ai.storyteller.artcraft-launcher" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\ArtCraft Launcher" Name="StartMenuShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>

      <!-- Only when the folder page's box is ticked; removed on uninstall like everything else. -->
      <Component Id="ArtCraftLauncherDesktopShortcut" Directory="DesktopFolder" Guid="CF06DCF3-BE5A-4A2B-B3BF-F553CC6E5D60"
          Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="ArtCraft Launcher"
            Description="Install and update the Craft App Suite"
            Target="[#ArtCraftLauncherExe]" WorkingDirectory="INSTALLFOLDER"
            Icon="ArtCraftLauncherIcon.exe" IconIndex="0">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="ai.storyteller.artcraft-launcher" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Learning Machines LLC\ArtCraft Launcher" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
