  "apps": {
    "anicraft": {
      "default_branch": "main",
      "display_name": "AniCraft",
      "entrypoints": {
        "linux-x86_64": {
          "binary": "anicraft-bin",
          "entrypoint": "anicraft"
        },
        "macos-aarch64": {
          "binary": "AniCraft Nightly.app/Contents/MacOS/AniCraft",
          "entrypoint": "AniCraft Nightly.app/Contents/MacOS/AniCraft"
        },
        "windows-x86_64": {
          "binary": "anicraft.exe",
          "entrypoint": "anicraft.exe"
        }
      },
      "env_prefix": "ANICRAFT",
      "note": "AniCraft nightly-v1 Windows x86_64 GUI ZIP (anicraft.exe at the archive root), Linux x86_64 GUI tar.gz started through the canonical launcher (anicraft) with anicraft-bin beside it, and macOS aarch64 notarized app ZIP (AniCraft Nightly.app), published together in one release.",
      "repository": "storytold/anicraft",
      "targets": [
        {
          "asset_pattern": "anicraft-{version}-windows-x86_64-nightly.zip",
          "isolation": {
            "associations": "none",
            "package_identity": "ai.storyteller.anicraft.nightly",
            "profile_contract": "nightly",
            "profile_version": 1
          },
          "target": {
            "arch": "x86_64",
            "format": "portable_zip",
            "os": "windows"
          }
        },
        {
          "asset_pattern": "anicraft-{version}-linux-x86_64-nightly.tar.gz",
          "isolation": {
            "associations": "none",
            "package_identity": "ai.storyteller.anicraft.nightly",
            "profile_contract": "nightly",
            "profile_version": 1
          },
          "target": {
            "arch": "x86_64",
            "format": "tar_gz",
            "os": "linux"
          }
        },
        {
          "asset_pattern": "anicraft-{version}-macos-aarch64-nightly.zip",
          "isolation": {
            "associations": "none",
            "package_identity": "ai.storyteller.anicraft.nightly",
            "profile_contract": "nightly",
            "profile_version": 1
          },
          "target": {
            "arch": "aarch64",
            "format": "portable_zip",
            "os": "macos"
          }
        }
      ]
    },
